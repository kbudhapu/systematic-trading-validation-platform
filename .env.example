# Alpaca API keys — use paper keys until ready for live
ALPACA_API_KEY=your_paper_key
ALPACA_SECRET_KEY=your_paper_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Email (SendGrid SMTP or Gmail app password)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
EMAIL_FROM=bot@yourdomain.com
# Supabase (dashboard sync — scoped keys; never use service_role on Vercel)
# Project URL only — do NOT append /rest/v1 (the client adds it)
SUPABASE_URL=https://your-project.supabase.co
# VPS bot: JWT minted for trading_bot_node (replaces service_role on droplet).
# SUPABASE_BOT_KEY is accepted as an alias for SUPABASE_TRADING_BOT_KEY.
SUPABASE_TRADING_BOT_KEY=your_trading_bot_node_jwt
# SUPABASE_BOT_KEY=your_trading_bot_node_jwt
# Break-glass migrations only — remove from droplet after the bot key is verified.
# Used outside backtest ⇒ the bot logs a per-boot WARNING (CP7 F3 / Gate A G-A3).
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional: names the runtime environment for the credential-scope warning (e.g. paper|live|backtest)
# TRADING_ENVIRONMENT=paper

# Control API (FastAPI sidecar)
CONTROL_API_TOKEN=generate_a_long_random_token
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=8000
