# ============ SUPABASE (dashboard login + data) ============
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer publishable key (Supabase → Settings → API). Legacy anon JWT also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_jwt

# Server-only scoped JWT for dashboard_api_node (strategy RPC + control_commands)
SUPABASE_DASHBOARD_API_KEY=your_dashboard_api_node_jwt
# Optional: must match droplet TRADING_ENVIRONMENT / snapshot primary key
# NEXT_PUBLIC_TRADING_ENVIRONMENT=production

# ============ CONTROL API (backtest / go-live / kill switch) ============
# Server-only URL preferred on Vercel (not exposed to browser):
CONTROL_API_URL=https://api.your-droplet.example.com
# Local dev fallback:
# NEXT_PUBLIC_CONTROL_API_URL=http://localhost:8000
CONTROL_API_TOKEN=generate_a_long_random_token
