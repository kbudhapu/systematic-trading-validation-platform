#!/usr/bin/env sh
# Optional local gate — enable with: git config core.hooksPath .githooks
set -eu

remote="${1:-}"
url="${2:-}"

zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"
  else
    range="${remote_sha}..${local_sha}"
  fi

  if git diff --name-only "$range" | grep -q '^dashboard/'; then
    echo "pre-push: dashboard files changed — running production build..."
    "$(dirname "$0")/../scripts/verify-dashboard-build.sh"
  fi
done

exit 0
